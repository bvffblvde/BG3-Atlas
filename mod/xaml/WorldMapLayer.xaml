                            <ItemsControl x:Name="BG3A_Layer" ItemsSource="{Binding Points}" IsHitTestVisible="False"
                                          Width="{Binding ElementName=MapImage,Path=ActualWidth}" Height="{Binding ElementName=MapImage,Path=ActualHeight}">
                                <ItemsControl.RenderTransform>
                                    <TransformGroup>
                                        <MatrixTransform Matrix="{Binding ProjectionMatrix,RelativeSource={RelativeSource AncestorType=ls:LSWorldMap}}" />
                                    </TransformGroup>
                                </ItemsControl.RenderTransform>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="1" Height="1" Fill="#FFE8C15A" Stroke="#FF1A1208" StrokeThickness="0.14">
                                            <Ellipse.RenderTransform>
                                                <TransformGroup>
                                                    <TranslateTransform X="-0.5" Y="-0.5"/>
                                                    <ScaleTransform ScaleX="{Binding Tag, RelativeSource={RelativeSource AncestorType=ls:LSWorldMap}, FallbackValue=6}"
                                                                    ScaleY="{Binding Tag, RelativeSource={RelativeSource AncestorType=ls:LSWorldMap}, FallbackValue=6}"/>
                                                    <TranslateTransform X="{Binding PosX}" Y="{Binding PosY}"/>
                                                </TransformGroup>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
